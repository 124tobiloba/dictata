{
  "name": "dictata",
  "version": "0.1.0",
  "description": "Dictata — hold a hotkey, speak, and polished text appears wherever your cursor is. Powered by Gemini.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "test": "node --test \"test/**/*.test.js\"",
    "test:paste": "electron scripts/test-paste.js",
    "test:api": "node scripts/test-api.js",
    "test:dashboard": "node --test test/dashboard.test.js",
    "test:mic": "electron scripts/mic-probe.js"
  },
  "author": "Vilian",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "uiohook-napi@1.5.5": true
  },
  "build": {
    "appId": "com.vilian.dictata",
    "productName": "Dictata",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "shortcutName": "Dictata"
    },
    "extraMetadata": {
      "main": "src/main/main.js"
    }
  }
}
